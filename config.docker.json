{
  "server": {
    "host": "0.0.0.0",
    "port": 11435,
    "api_key": "local-proxy-token",
    "request_timeout_seconds": 3600,
    "routing_strategy": "sticky_failover",
    "max_retries": 1,
    "max_attempts_per_request": 0,
    "failure_cooldown_seconds": 60,
    "retry_backoff_seconds": 0,
    "retry_on_any_acp_error": false,
    "affinity_prefix_chars": 4096
  },
  "agents": [
    {
      "name": "opencode",
      "instance_id": "opencode-a",
      "command": "opencode",
      "args": ["acp"],
      "cwd": ".",
      "models": ["opencode-big-pickle", "opencode-mimo", "opencode-nemotron"],
      "model_selection": {
        "type": "session_config",
        "config_id": "model",
        "values": {
          "opencode-big-pickle": "opencode/big-pickle",
          "opencode-mimo":       "opencode/mimo-v2.5-free",
          "opencode-nemotron":   "opencode/nemotron-3-ultra-free"
        },
        "required": true
      },
      "env": {
        "HOME": "${AUTH_ROOT:-$HOME/.acp-auth}/opencode-a",
        "XDG_DATA_HOME": "${AUTH_ROOT:-$HOME/.acp-auth}/opencode-a/.local/share",
        "XDG_CONFIG_HOME": "${AUTH_ROOT:-$HOME/.acp-auth}/opencode-a/.config"
      },
      "permission": "deny"
    },
    {
      "name": "opencode",
      "instance_id": "opencode-b",
      "command": "opencode",
      "args": ["acp"],
      "cwd": ".",
      "models": ["opencode-big-pickle", "opencode-mimo", "opencode-nemotron"],
      "model_selection": {
        "type": "session_config",
        "config_id": "model",
        "values": {
          "opencode-big-pickle": "opencode/big-pickle",
          "opencode-mimo":       "opencode/mimo-v2.5-free",
          "opencode-nemotron":   "opencode/nemotron-3-ultra-free"
        },
        "required": true
      },
      "env": {
        "HOME": "${AUTH_ROOT:-$HOME/.acp-auth}/opencode-b",
        "XDG_DATA_HOME": "${AUTH_ROOT:-$HOME/.acp-auth}/opencode-b/.local/share",
        "XDG_CONFIG_HOME": "${AUTH_ROOT:-$HOME/.acp-auth}/opencode-b/.config"
      },
      "permission": "deny"
    },
    {
      "name": "claude",
      "instance_id": "claude-ka",
      "command": "claude-agent-acp",
      "args": [],
      "cwd": ".",
      "models": ["haiku"],
      "env": {
        "ANTHROPIC_MODEL": "haiku",
        "HOME": "${AUTH_ROOT:-$HOME/.acp-auth}/claude-ka"
      },
      "permission": "deny"
    },
    {
      "name": "github-gpt-5-mini",
      "instance_id": "github-gpt-5-mini-ka",
      "command": "copilot",
      "args": ["--acp", "--stdio", "--model", "gpt-5-mini", "--effort", "high"],
      "cwd": ".",
      "models": ["gpt-5-mini"],
      "env": {
        "COPILOT_MODEL": "gpt-5-mini",
        "HOME": "${AUTH_ROOT:-$HOME/.acp-auth}/github-gpt-5-mini-ka"
      },
      "permission": "deny"
    }
  ]
}
